<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Admin - Modificar Producto</title>
    <style>
        /* TODO pasarlos al css*/
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; background-color: #f4f4f4; }
        .navbar { background: #333; color: white; padding: 15px; display: flex; justify-content: space-between; }
        .navbar a { color: white; text-decoration: none; margin-right: 15px; font-weight: bold; }
        .container { max-width: 600px; margin: 40px auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
        .form-group input, .form-group select { width: 100%; padding: 8px; box-sizing: border-box; }
        button { margin: 10px; background: #28a745; color: white; border: none; padding: 10px 15px; cursor: pointer; border-radius: 4px; font-size: 16px; width: 100%;}
        button:hover { background: #218838; }
        #mensaje { margin-top: 15px; text-align: center; font-weight: bold; }
    </style>
</head>
<body>

    <%- include('./partials/navegacion')%>

    <div class="container">
        <h2> Modificar Producto </h2>
        
        <form id="formularioProducto" action="/admin/productos/modificar/<%= producto.id %>" method="POST" enctype="multipart/form-data">

            <div class="form-group">
                <label for="nombre">Nombre del Producto:</label>
                <input type="text" id="nombre" name="nombre" value="<%= producto.nombre %>">
            </div>

            <div class="form-group">
                <label for="precio">Precio ($):</label>
                <input type="number" id="precio" name="precio" value="<%= producto.precio %>">
            </div>

            <div class="form-group">
                <label for="genero">Género:</label>
                <select id="genero" name="genero">
                    <option value="" disabled hidden>Elige una opción...</option>
                    <option value="Terror" <%= producto.genero === 'Terror' ? 'selected' : '' %>>Terror</option>
                    <option value="Suspenso" <%= producto.genero === 'Suspenso' ? 'selected' : '' %>>Suspenso</option>
                    <option value="Thriller" <%= producto.genero === 'Thriller' ? 'selected' : '' %>>Thriller</option>
                    <option value="Drama" <%= producto.genero === 'Drama' ? 'selected' : '' %>>Drama</option>
                    <option value="Comedia" <%= producto.genero === 'Comedia' ? 'selected' : '' %>>Comedia</option>
                    <option value="Ciencia Ficcion" <%= producto.genero === 'Ciencia Ficcion' ? 'selected' : '' %>>Ciencia Ficcion</option>
                    <option value="Accion" <%= producto.genero === 'Accion' ? 'selected' : '' %>>Accion</option>
                    <option value="Disco" <%= producto.genero === 'Disco' ? 'selected' : '' %>>Disco</option>
                    <option value="Pop" <%= producto.genero === 'Pop' ? 'selected' : '' %>>Pop</option>
                    <option value="Rock" <%= producto.genero === 'Rock' ? 'selected' : '' %>>Rock</option>
                    <option value="Rock Alternativo" <%= producto.genero === 'Rock Alternativo' ? 'selected' : '' %>>Rock alternativo</option>
                    <option value="Grunge" <%= producto.genero === 'Grunge' ? 'selected' : '' %>>Grunge</option>
                    <option value="Musica Urbana" <%= producto.genero === 'Musica Urbana' ? 'selected' : '' %>>Musica Urbana</option>
                    <option value="Jazz - Blues - Soul" <%= producto.genero === 'Jazz - Blues - Soul' ? 'selected' : '' %>>Jazz - Blues - Soul</option>
                </select>
            </div>

            <div class="form-group">
                <label for="tipo">Tipo de Coleccionable:</label>
                <select id="tipo" name="categoria" required>
                    <option value="" disabled selected hidden>Elige una opción...</option>
                    <option value="DVD">DVD</option>
                    <option value="VINILO">Vinilo</option>
                </select>
            </div>

            <div class="form-group">
                <label for="imagen">Imagen de Portada:</label>
                <input type="file" id="imagen" name="imagen" accept="image/*">
            </div>

            <button type="submit" id="btnGuardar">Guardar Producto</button>
            
            <div id="mensaje"></div>
        </form>

        <form id="formEliminarProducto" action="/admin/productos/<%= producto.id %>/estado" method="POST">
            <input type="hidden" name="estado" value="0">
            <button type="button" class="btn-estado" data-id="<%= producto.id %>" data-estado="<%= producto.estado ? 0 : 1 %>"> <%= producto.estado ? 'Dar de Baja' : 'Reactivar' %></button>
        </form>
    </div>

     <script src="/js/modificar.js"></script>
</body>
</html>