    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Panel Admin - Consultar Productos</title>
        <style>
            /* TODO: pasarlos al css */
            body { font-family: Arial, sans-serif; margin: 0; padding: 0; background-color: #f4f4f4; }
            .navbar { background: #333; color: white; padding: 15px; display: flex; justify-content: space-between; }
            .navbar a { color: white; text-decoration: none; margin-right: 15px; font-weight: bold; }
            .container { max-width: 600px; margin: 40px auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
            .form-group { margin-bottom: 15px; }
            .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
            .form-group input, .form-group select { width: 100%; padding: 8px; box-sizing: border-box; }
            button { background: #28a745; color: white; border: none; padding: 10px 15px; cursor: pointer; border-radius: 4px; font-size: 16px; width: 100%;}
            button:hover { background: #218838; }
            #mensaje { margin-top: 15px; text-align: center; font-weight: bold; }
        </style>
    </head>
    <body>

        <%- include('./partials/navegacion')%>

        <div class="container">
            <h2>Consultar Productos</h2>
            
            <form action="/productos/consultar" method="GET"> 
                
                <div class="form-group">
                    <label for="id">ID del Producto:</label>
                    <input type="text" id="id" name="id" required>
                </div>

                <button type="submit" id="btnGuardar">Realizar Consulta</button>
                
                <div id="mensaje"></div>
            </form>

        </div>

        <div class="container">
        <h1>Inventario</h1>

        <% if (typeof mensajeError !== 'undefined') { %>
            <p style="color: red; font-weight: bold;"><%= mensajeError %></p>
        <% } %>

        <table border="1" width="100%" cellspacing="0" cellpadding="10">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Precio</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                <% if (productos && productos.length > 0) { %>
                    
                    <% productos.forEach(producto => { %>
                        <tr>
                            <td><%= producto.id %></td>
                            <td>
                                <img src="<%= producto.imagen%>" alt="" width="50">
                            </td>
                            <td><%= producto.nombre %></td>
                            <td><%= producto.genero || producto.tipo %></td>
                            <td>$<%= producto.precio %></td>
                            <td>
                                <%= producto.estado ? 'Activo' : 'Inactivo' %>
                            </td>
                        </tr>
                        </tr>
                    <% }) %>

                <% } else { %>
                    <tr>
                        <td colspan="7" style="text-align: center;">No hay productos cargados en el sistema.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        </div>
        
    </body>
    </html>